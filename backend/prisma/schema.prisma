generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  CITIZEN
  ADMIN
}
enum ComplaintStatus {
  SUBMITTED
  IN_REVIEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
}
enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
enum AIReviewState {
  PENDING
  COMPLETED
  NEEDS_HUMAN_REVIEW
  APPROVED
  CORRECTED
  FAILED
}

model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  name String
  role Role @default(CITIZEN)
  complaints Complaint[]
  reviewed ComplaintsReview[]
  statusChanges StatusHistory[]
  reviewedAnalyses AIAnalysis[] @relation("AIAnalysisReviewedBy")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Complaint {
  id String @id @default(uuid())
  title String
  description String
  category String
  status ComplaintStatus @default(SUBMITTED)
  priority ComplaintPriority @default(MEDIUM)
  latitude Float?
  longitude Float?
  address String?
  photoUrl String?
  aiCategory String?
  aiSummary String?
  correctionNote String?
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  reviews ComplaintsReview[]
  statusHistory StatusHistory[]
  aiAnalyses AIAnalysis[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([latitude, longitude])
}
model AIAnalysis {
  id String @id @default(uuid())
  complaintId String
  category String
  summary String
  priority ComplaintPriority
  confidence Float
  reason String
  needsHumanReview Boolean
  provider String
  model String
  state AIReviewState @default(PENDING)
  reviewedById String?
  reviewNote String?
  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("AIAnalysisReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([complaintId, createdAt])
}
model StatusHistory {
  id String @id @default(uuid())
  complaintId String
  fromStatus ComplaintStatus?
  toStatus ComplaintStatus
  changedById String?
  notes String?
  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([complaintId, createdAt])
}
model ComplaintsReview {
  id String @id @default(uuid())
  complaintId String
  adminId String
  decision String
  notes String?
  complaint Complaint @relation(fields:[complaintId], references:[id], onDelete:Cascade)
  admin User @relation(fields:[adminId], references:[id])
  createdAt DateTime @default(now())
}
